<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.facerec.guard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python</string>
    <string>-m</string>
    <string>app.main</string>
    <string>--timeout</string>
    <string>10</string>
    <string>--fps</string>
    <string>5</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ariz/projects/facerec</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/facerec.guard.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/facerec.guard.err.log</string>
</dict>
</plist>
